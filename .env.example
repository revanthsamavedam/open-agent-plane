# Open Agent Plane — example configuration. Copy to .env and edit.
# Never put real secrets in this file; connectors use references (env:/vault:/secret:).

# BYO model: any Pydantic AI model string, e.g.
#   openai:gpt-4o | azure:<deployment> | anthropic:claude-sonnet-4-5
#   bedrock:... | google:... | ollama:llama3.1
# Blank = offline TestModel placeholder (demo only).
AGENTPLANE_MODEL=

# Model provider keys are read by the model library from ITS environment,
# e.g. OPENAI_API_KEY / ANTHROPIC_API_KEY / AZURE_OPENAI_API_KEY — set them
# in your deployment secret manager, not here.
OPENAI_API_KEY=

# Auth: demo (local only) or jwt (OIDC). jwt requires JWT_SECRET and never
# falls back to demo silently.
AUTH_MODE=demo
JWT_SECRET=

# Storage: SQLite path (default) — DATABASE_URL is the Postgres seam for
# deployments; the reference store uses AGENTPLANE_DB.
AGENTPLANE_DB=data/agentplane.db
DATABASE_URL=

# Local stand-in data for LIVE connectors.
AGENTPLANE_STANDIN_DIR=data/standin
